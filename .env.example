# Server-only OpenRouter key. Never use a VITE_ prefix for secrets.
OPENROUTER_API_KEY=
FREEAI_MODEL=openrouter/free
FREEAI_ALLOWED_ORIGINS=http://localhost:5173
FREEAI_SITE_URL=
# Optional cloud sync/auth. These two values are public client configuration, not secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
