# Create a key with a provider that offers free model access.
# Keep this key server-side in Vercel Environment Variables. Never put it in VITE_* variables.
OPENROUTER_API_KEY=
# openrouter/free automatically routes to an eligible free model.
FREEAI_MODEL=openrouter/free
# Comma-separated exact origins, e.g. https://freeai-yourname.vercel.app
FREEAI_ALLOWED_ORIGINS=http://localhost:5173